{
  "name": "claude-kimi-mcp",
  "version": "1.2.0",
  "description": "MCP Server for Claude Code: delegate coding tasks to Kimi K2.6 agent, reduce AI cost by 60–70% without sacrificing quality",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-kimi-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "openai": "^4.97.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
